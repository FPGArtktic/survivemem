# Quadlet unit (rootless Podman, systemd user service).
#   cp deploy/survivemem.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload && systemctl --user start survivemem
# The bind mount keeps the DB and daemon.token where the host CLI and hook clients look.
[Unit]
Description=survivemem daemon (MCP over HTTP + hook endpoint)

[Container]
Image=localhost/survivemem:latest
Exec=serve --http --bind 0.0.0.0:8765
# :Z relabels for SELinux (Fedora/RHEL); drop it on Arch/Debian.
Volume=%h/.local/share/survivemem:/data:Z
UserNS=keep-id
# map host.containers.internal (169.254.1.2) to the host's loopback, where Ollama listens
Network=pasta:--map-host-loopback,169.254.1.2
PublishPort=127.0.0.1:8765:8765
Environment=SURVIVEMEM_OLLAMA_URL=http://host.containers.internal:11434

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
